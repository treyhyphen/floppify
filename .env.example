FLOPPIFY_SPOTIFY_CLIENT_ID=
FLOPPIFY_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
FLOPPIFY_STATE_DIR=/var/lib/floppify
FLOPPIFY_MEDIA_ROOTS=/media,/mnt/floppify
FLOPPIFY_DISK_POLL_SECONDS=2
FLOPPIFY_SONOS_ENABLED=true
FLOPPIFY_SONOS_DISCOVERY_TIMEOUT=2
# FLOPPIFY_SONOS_INTERFACE_ADDR=192.168.1.50
FLOPPIFY_FLOPPY_THUMP_ENABLED=true
# FLOPPIFY_FLOPPY_THUMP_DEVICE=/dev/sda
