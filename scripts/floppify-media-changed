#!/bin/bash
# udev handler for floppy media insert/eject.
# On insert, mount read-only; on eject, unmount and tell Floppify to stop now.
set -u

# Read Floppify env overrides if present (defaults below match the app).
if [ -r /etc/floppify.env ]; then
  # shellcheck disable=SC1091
  . /etc/floppify.env
fi

DEVICE="${FLOPPIFY_FLOPPY_DEVICE:-/dev/sda}"
MOUNT="${FLOPPIFY_FLOPPY_MOUNT:-/mnt/floppify}"
SIZE_FILE="/sys/class/block/$(basename "$DEVICE")/size"

size=0
[ -r "$SIZE_FILE" ] && size=$(cat "$SIZE_FILE" 2>/dev/null)

if [ "${size:-0}" -gt 0 ] 2>/dev/null; then
    # Media present: mount if not already mounted.
    /usr/bin/findmnt -n "$MOUNT" >/dev/null 2>&1 || \
        /usr/bin/mount -t vfat -o ro,noexec,nodev,nosuid "$DEVICE" "$MOUNT"
else
    # Media gone: unmount and stop playback immediately.
    if /usr/bin/findmnt -n "$MOUNT" >/dev/null 2>&1; then
        /usr/bin/umount "$MOUNT"
    fi
    /usr/bin/curl -fsS --max-time 5 --noproxy '*' \
        -X POST http://127.0.0.1:8000/api/eject >/dev/null 2>&1 || true
fi

exit 0
